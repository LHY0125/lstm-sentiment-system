<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig36" name="图3-6 批量分析与导出">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="940" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="① 输入与前端校验" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="900" height="260" as="geometry" /></mxCell>
        <mxCell id="c2" value="② 后端批量推理" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="900" height="350" as="geometry" /></mxCell>
        <mxCell id="c3" value="③ 结果展示与导出" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="900" height="370" as="geometry" /></mxCell>
        <mxCell id="n-start" value="开始：用户输入" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="370" y="32" width="200" height="46" as="geometry" /></mxCell>
        <mxCell id="n-p1" value="前端按行切分、去空行&lt;br&gt;校验不超过 1000 条" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="n-d1" value="有有效文本？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="360" y="178" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n-err1" value="提示错误&lt;br&gt;保留已有结果" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="186" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="n-note1" value="前端只做解析与条数校验；&lt;br&gt;阈值不参与本次请求" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="250" height="62" as="geometry" /></mxCell>
        <mxCell id="n-p2" value="POST /api/batch&lt;br&gt;批量文本 / 模型 / 截断长度" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="312" width="280" height="62" as="geometry" /></mxCell>
        <mxCell id="n-p3" value="参数校验；按 BATCH_SIZE=64 分批" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="396" width="280" height="58" as="geometry" /></mxCell>
        <mxCell id="n-p4" value="逐批前向（LSTM）&lt;br&gt;避免一次性占满显存" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="280" height="58" as="geometry" /></mxCell>
        <mxCell id="n-p5" value="每条 prob_pos / prob_neg&lt;br&gt;按输入顺序组装 JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="n-note2" value="批量接口不接收阈值；&lt;br&gt;后端只返回概率" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="410" width="220" height="62" as="geometry" /></mxCell>
        <mxCell id="n-d2" value="请求成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="360" y="682" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n-err2" value="错误横幅&lt;br&gt;保留已有结果" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="690" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="n-p6" value="前端阈值 → 标签（本地）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="776" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n-p7" value="结果表：原文 / 概率 / 标签" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="848" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n-p8" value="导出 CSV（含阈值后的标签）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="920" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n-end" value="结束" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="400" y="980" width="140" height="46" as="geometry" /></mxCell>
        <mxCell id="n-note3" value="阈值变化只重算标签，&lt;br&gt;不重新请求后端" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="n-note4" value="请求失败时不清空已有结果，&lt;br&gt;用户可直接重试" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="776" width="220" height="58" as="geometry" /></mxCell>
