<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig21" name="图2-1 总体技术路线">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" value="图例：实线=调用/数据流；橙色虚线=产物只读消费；左=离线训练，右=在线推理" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="820" height="24" as="geometry" /></mxCell>

        <!-- 两个阶段的虚线容器 -->
        <mxCell id="grpL" value="① 离线训练（只写产物）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="330" height="460" as="geometry" />
        </mxCell>
        <mxCell id="grpR" value="② 在线推理（只读产物）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="330" height="390" as="geometry" />
        </mxCell>

        <!-- 左侧：训练链路 -->
        <mxCell id="L1" value="数据集/（五个语料）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="65" y="110" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="数据层data.py&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;下载 · 校验 · 分词 · 建表 · 编码&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="65" y="190" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="模型层model.py&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;Embedding + LSTM + Linear&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="65" y="272" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="训练层train.py&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;6组网格 · 验证集选优&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="65" y="354" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="产物：*.pt + vocab.json + meta.json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FED7AA;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="65" y="436" width="280" height="58" as="geometry" />
        </mxCell>

        <!-- 右侧：推理链路 -->
        <mxCell id="R1" value="前端React&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;单条 / 批量 / 参数调节&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="495" y="110" width="280" height="62" as="geometry" />
