        <mxCell id="eL4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eR1" value="HTTP / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#047857;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;" edge="1" parent="1" source="R2" target="R3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;" edge="1" parent="1" source="R3" target="R4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 跨阶段：产物 → 推理层 -->
        <mxCell id="eX" value="只消费产物&lt;br&gt;不参与训练" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#B45309;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#B45309;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="L5" target="R3">
          <mxGeometry relative="1" as="geometry">
