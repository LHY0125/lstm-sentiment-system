        <mxCell id="R3" value="推理层infer.py&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;载入产物 · 预测 · 遮挡法&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="495" y="278" width="280" height="62" as="geometry" />
