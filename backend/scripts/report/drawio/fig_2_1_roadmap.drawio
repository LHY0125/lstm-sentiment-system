        <mxCell id="R2" value="接口层api.py&lt;br&gt;&lt;span style='font-size:13.5px;color:#4B5563'&gt;5条REST路由&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
