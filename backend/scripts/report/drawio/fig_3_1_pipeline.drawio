<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig31" name="图3-1 数据预处理流程">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="940" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="① 语料获取与校验" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="900" height="310" as="geometry" /></mxCell>
        <mxCell id="c2" value="② 标签统一与清洗" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="900" height="290" as="geometry" /></mxCell>
        <mxCell id="c3" value="③ 划分与词表" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="900" height="240" as="geometry" /></mxCell>
        <mxCell id="c4" value="④ 定长编码与产出" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="920" width="900" height="200" as="geometry" /></mxCell>
        <mxCell id="n-start" value="开始：5 个语料" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="370" y="30" width="200" height="46" as="geometry" /></mxCell>
        <mxCell id="n-p1" value="按序选择镜像源&lt;br&gt;下载到临时文件" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="280" height="58" as="geometry" /></mxCell>
        <mxCell id="n-d1" value="可解析且&lt;br&gt;样本数 &amp;gt; 0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="350" y="172" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="n-retry" value="切换下一镜像（重试）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="182" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="n-p2" value="原子改名落盘" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="268" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="n-note1" value="校验失败按下载失败处理：&lt;br&gt;否则 HTTP 200 的 HTML 错误页&lt;br&gt;会被永久固化成语料" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="280" height="82" as="geometry" /></mxCell>
        <mxCell id="n-p3" value="合并 5 个语料&lt;br&gt;1,856,043 条" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="362" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p4" value="标签映射&lt;br&gt;4–5★=1、1–2★=0、3★丢弃" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="280" height="64" as="geometry" /></mxCell>
        <mxCell id="n-d2" value="取值合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="350" y="520" width="240" height="72" as="geometry" /></mxCell>
        <mxCell id="n-err" value="抛错（失败关闭）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="530" width="200" height="52" as="geometry" /></mxCell>
        <mxCell id="n-note2" value="中性样本直接丢弃：&lt;br&gt;宁可少要样本，不制造假标签" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="280" height="64" as="geometry" /></mxCell>
        <mxCell id="n-p5" value="jieba 分词 + 去标点" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="672" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="n-p6" value="全局随机划分 9:1&lt;br&gt;训练集内再切 10% 验证" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="738" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p7" value="词表：前 20000、频次 ≥ 2&lt;br&gt;0=&amp;lt;pad&amp;gt;、1=&amp;lt;unk&amp;gt;、实词从 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="808" width="280" height="76" as="geometry" /></mxCell>
        <mxCell id="n-note3" value="不按语料分层：&lt;br&gt;三个集合类别分布一致" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="738" width="280" height="58" as="geometry" /></mxCell>
        <mxCell id="n-note4" value="词表只统计训练集，&lt;br&gt;避免测试集词频泄漏" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="738" width="240" height="58" as="geometry" /></mxCell>
        <mxCell id="n-p8" value="截断 / 填充至 MAX_LEN=150&lt;br&gt;记录 lengths（真实词数）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="932" width="280" height="62" as="geometry" /></mxCell>
        <mxCell id="n-end" value="产出编码张量" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="360" y="1014" width="220" height="52" as="geometry" /></mxCell>
        <mxCell id="n-note5" value="编码矩阵 + lengths&lt;br&gt;+ DataLoader" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="932" width="240" height="58" as="geometry" /></mxCell>
