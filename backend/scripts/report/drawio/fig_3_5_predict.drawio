  <diagram id="fig35" name="图3-5 单条预测与逐词贡献">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="① 请求与预处理" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="570" as="geometry" /></mxCell>
        <mxCell id="c2" value="② 模型前向" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="300" height="570" as="geometry" /></mxCell>
        <mxCell id="c3" value="③ 标签判定与逐词贡献" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="660" y="20" width="400" height="700" as="geometry" /></mxCell>
        <mxCell id="n-start" value="输入评论文本" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="n-p1" value="前端校验：非空&lt;br&gt;长度 ≤ 2000 字符" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="124" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p2" value="POST /api/predict&lt;br&gt;或 /api/explain" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="200" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p3" value="后端参数校验&lt;br&gt;未知参数 / 超限 → 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="276" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p4" value="jieba 分词&lt;br&gt;截断至 MAX_LEN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="352" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-p5" value="查表转索引、补 &amp;lt;pad&amp;gt;&lt;br&gt;记录 lengths" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="428" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-note1" value="分词与索引只在服务端完成" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="260" height="46" as="geometry" /></mxCell>
        <mxCell id="n-emb" value="Embedding&lt;br&gt;20002 × 128" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="62" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="n-lstm" value="LSTM&lt;br&gt;层数 × 隐藏维" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="136" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="n-gather" value="按 lengths 取&lt;br&gt;最后一个真实词" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="210" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-linear" value="Linear&lt;br&gt;hidden → 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="286" width="250" height="54" as="geometry" /></mxCell>
        <mxCell id="n-soft" value="softmax&lt;br&gt;prob_pos + prob_neg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="356" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-json" value="返回 predict JSON&lt;br&gt;label / prob / tokens" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="432" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="n-note2" value="explain 复用同一段输入，&lt;br&gt;概率与标签和 predict 完全一致" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="514" width="260" height="46" as="geometry" /></mxCell>
        <mxCell id="n-th" value="前端按阈值判标签&lt;br&gt;（纯本地，不发请求）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="62" width="340" height="60" as="geometry" /></mxCell>
        <mxCell id="n-d1" value="请求 explain？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="700" y="148" width="240" height="76" as="geometry" /></mxCell>
        <mxCell id="n-no" value="仅返回概率" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="158" width="100" height="54" as="geometry" /></mxCell>
        <mxCell id="n-occ" value="逐词遮挡：索引改为 &amp;lt;unk&amp;gt;&lt;br&gt;（最多 100 个词位）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="250" width="340" height="62" as="geometry" /></mxCell>
        <mxCell id="n-re" value="每个词位重新前向一次" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="340" height="50" as="geometry" /></mxCell>
