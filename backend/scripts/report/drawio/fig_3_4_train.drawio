<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig34" name="图3-4 模型训练流程">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="940" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="① 数据准备" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="900" height="230" as="geometry" /></mxCell>
        <mxCell id="c2" value="② 单组配置的训练循环" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="900" height="530" as="geometry" /></mxCell>
        <mxCell id="c3" value="③ 六组实验与最终评估" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="900" height="270" as="geometry" /></mxCell>
        <mxCell id="n-start" value="开始：6 组网格配置" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="370" y="55" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="n-prep" value="prepare()：载入并编码&lt;br&gt;训练 / 验证 / 测试" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="n-note1" value="只编码一次：184 万条&lt;br&gt;(N,150) int64 ≈ 2 GB&lt;br&gt;避免重复分词与内存耗尽" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="n-init" value="初始化模型 / Adam(1e-3)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="282" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n-train" value="训练一个 epoch（batch=64）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="348" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n-val" value="验证集评估 val_acc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="414" width="260" height="46" as="geometry" /></mxCell>
        <mxCell id="n-best" value="提升则保存该轮权重" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="476" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n-d2" value="已满 15 轮？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="350" y="542" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="n-d3" value="还有配置未训？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="350" y="632" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="n-note2" value="只保留 val_acc 最高的轮次；&lt;br&gt;实测六组最优轮次&lt;br&gt;都落在第 3–5 轮" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="348" width="240" height="78" as="geometry" /></mxCell>
        <mxCell id="n-note3" value="网格排序、默认模型、最优轮次&lt;br&gt;一律按验证准确率；测试集&lt;br&gt;不参与任何决策" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="n-load" value="载入各组最佳权重" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="832" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n-test" value="测试集评估（仅报告一次）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="898" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n-end" value="输出三项指标 + 产物" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F5F5F5;strokeColor=#334155;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="350" y="968" width="240" height="46" as="geometry" /></mxCell>
        <mxCell id="n-note4" value="产物：checkpoint_*.pt +&lt;br&gt;vocab.json + meta.json&lt;br&gt;（vocab_size 与模型同源）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="832" width="240" height="78" as="geometry" /></mxCell>
