        </mxCell>
        <mxCell id="tanh2xh" style="html=1;strokeColor=#1D4ED8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tanhBox" target="nXh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hOut" value="h(t)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
