        <mxCell id="branch" style="html=1;strokeColor=#1D4ED8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
