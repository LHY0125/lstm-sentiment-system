        <!-- 底部说明 -->
        <mxCell id="tip" value="细胞状态沿水平线以加法更新，梯度可近乎无衰减地回传" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
