<mxfile host="app.diagrams.net" type="device">
  <diagram id="fig32" name="图3-2 LSTM 单元结构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="870" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cCell" value="LSTM 单元（时刻 t）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;verticalAlign=top;align=right;spacingRight=18;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="840" height="470" as="geometry" /></mxCell>

        <!-- 顶端更新公式 -->
        <mxCell id="formula" value="C(t) = f ⊙ C(t-1) + i ⊙ C′(t)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="250" y="6" width="420" height="30" as="geometry" />
        </mxCell>

        <!-- 细胞状态水平线两端 -->
        <mxCell id="ct1" value="C(t-1)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ct2" value="C(t)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="700" y="56" width="90" height="46" as="geometry" />
        </mxCell>

        <!-- 运算节点 -->
        <mxCell id="nXf" value="×" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="162" y="61" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="nAdd" value="+" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="382" y="61" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="nXh" value="×" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="592" y="282" width="36" height="36" as="geometry" />
        </mxCell>

        <!-- 细胞状态主线（粗蓝） -->
        <mxCell id="c1" style="html=1;strokeColor=#1D4ED8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ct1" target="nXf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="html=1;strokeColor=#1D4ED8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nXf" target="nAdd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="html=1;strokeColor=#1D4ED8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nAdd" target="ct2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="610" y="79" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 从 C(t) 分出 tanh 支路 -->
        <mxCell id="tanhBox" value="tanh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;" vertex="1" parent="1">
