        <mxCell id="gC" value="候选C′(t)&lt;br&gt;&lt;span style='font-size:13px;color:#4B5563'&gt;tanh&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="425" y="200" width="150" height="62" as="geometry" />
        </mxCell>
        <mxCell id="gO" value="输出门o&lt;br&gt;&lt;span style='font-size:13px;color:#4B5563'&gt;σ&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FED7AA;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#1F2937;" vertex="1" parent="1">
