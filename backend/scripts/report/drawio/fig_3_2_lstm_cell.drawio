        <!-- 四个门 -->
        <mxCell id="gF" value="遗忘门f&lt;br&gt;&lt;span style='font-size:13px;color:#4B5563'&gt;σ&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FED7AA;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#1F2937;" vertex="1" parent="1">
